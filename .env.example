# HireMind AI Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=HireMind AI
APP_ENV=development
DEBUG=true

# Database - PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://hiremind:hiremind123@localhost:5432/hiremind

# JWT Configuration
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ChromaDB
CHROMA_PERSIST_DIRECTORY=chroma_data
